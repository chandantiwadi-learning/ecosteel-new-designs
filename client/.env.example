# Eco Steel Engineering - Frontend Environment Variables

# Backend API Base URL
# In local development: http://localhost:5000 (or leave empty if using Vite proxy)
# In production on Vercel: Set to your live Render backend URL (e.g. https://ecosteel-new-designs.onrender.com)
VITE_API_URL=http://localhost:5000

# Cloudflare Turnstile CAPTCHA Site Key
# Get your site key from Cloudflare Dashboard -> Turnstile -> Sites
# Cloudflare Test Key (Always Passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

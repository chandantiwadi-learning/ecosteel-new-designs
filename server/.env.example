# Eco Steel Engineering - Backend Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ecosteel?retryWrites=true&w=majority
MONGODB_URI=

# Resend Transactional Email API Key
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=

# Sender Email Address (Must be a domain verified in Resend, or onboarding@resend.dev for testing)
FROM_EMAIL=Eco Steel Engineering <onboarding@resend.dev>

# Eco Steel Internal Team Recipient Email (Where business inquiry notifications are delivered)
TEAM_EMAIL=sales@ecosteels.com

# Frontend Application Origin (For CORS policy)
CLIENT_URL=http://localhost:5173
